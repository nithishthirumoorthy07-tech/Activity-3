# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# ---------- Local development defaults ----------
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Production (Render) overrides ----------
# Set these as environment variables in the Render dashboard, NOT in this file.
#
# DJANGO_SECRET_KEY=<a-long-random-secret-key>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=<your-render-app>.onrender.com
# CORS_ALLOWED_ORIGINS=https://nithishthirumoorthy07-tech.github.io
# DATABASE_URL=<set automatically by Render when you add a PostgreSQL database>
